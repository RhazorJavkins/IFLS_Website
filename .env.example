APP_NAME="IF Language School"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_SUPPORTED_LOCALES=id,en,zh

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Database — dev pakai SQLite, produksi (VPS) ganti ke mysql
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=ifls
# DB_USERNAME=ifls_user
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false   # true saat berjalan di HTTPS (produksi)

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# ===== Custom IFLS =====
# Google Analytics 4 — kosongkan untuk mematikan script GA
GA_MEASUREMENT_ID=

# Allowlist IP untuk /admin (dipisah koma). Kosongkan = tidak dibatasi IP.
# Contoh: ADMIN_IP_ALLOWLIST=103.10.0.5,182.253.10.1
ADMIN_IP_ALLOWLIST=

# Nomor WhatsApp utama (fallback form kontak bila DB gagal)
WHATSAPP_NUMBER=628118887568
